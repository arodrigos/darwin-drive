{
  "name": "darwin-drive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test --test-concurrency=1 tests/unit/*.test.ts",
    "test:e2e": "playwright test tests/e2e --project=chromium",
    "test:e2e:tabletas": "playwright test tests/e2e --project=tableta-vertical --project=tableta-horizontal",
    "verificar:presupuesto-bundle": "node scripts/comprobar-presupuesto-bundle.mjs",
    "verificar:publico": "node scripts/comprobar-publico.mjs",
    "verificar:frontera-nucleo": "node scripts/comprobar-frontera-nucleo.mjs",
    "medir:fisica": "node --import tsx scripts/medir-fisica.ts",
    "medir:anomalias": "node --import tsx scripts/medir-anomalias.ts",
    "medir:evolucion": "node --import tsx scripts/medir-evolucion.ts",
    "medir:fragilidad": "node --import tsx scripts/medir-fragilidad.ts",
    "medir:pistas": "node --import tsx scripts/medir-pistas.ts",
    "generar:escenario-evolucion": "node --import tsx scripts/generar-escenario-evolucion.ts",
    "generar:escenario-especies": "node --import tsx scripts/generar-escenario-especies.ts",
    "smoke:traspaso": "bash scripts/smoke-traspaso.sh",
    "generar:escenarios": "node --import tsx scripts/generar-escenarios.ts",
    "generar:escenario-linaje": "node --import tsx scripts/generar-escenario-linaje.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@serwist/turbopack": "9.5.13",
    "@serwist/window": "9.5.13",
    "idb-keyval": "^6.3.0",
    "next": "16.4.2",
    "phaser": "^4.2.1",
    "planck": "1.5.1",
    "pure-rand": "^8.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "9.5.13",
    "simplex-noise": "^4.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
